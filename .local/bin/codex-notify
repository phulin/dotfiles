#!/usr/bin/env python3
"""Show Codex turn-complete notifications through tmux and SSH."""

import json
import os
import re
import subprocess
import sys
from pathlib import Path


MAX_SUMMARY_CHARS = 240
TMUX_MESSAGE_MS = 10000


def install_config() -> int:
    config_dir = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
    config_path = config_dir / "config.toml"
    command_path = Path.home() / ".local" / "bin" / "codex-notify"
    notify_line = f"notify = [{json.dumps(str(command_path))}]"

    config_dir.mkdir(parents=True, exist_ok=True)
    if config_path.exists():
        lines = config_path.read_text().splitlines()
        table_index = next(
            (index for index, line in enumerate(lines) if line.lstrip().startswith("[")),
            len(lines),
        )
        notify_index = next(
            (
                index
                for index, line in enumerate(lines[:table_index])
                if re.match(r"^\s*notify\s*=", line)
            ),
            None,
        )
        if notify_index is None:
            lines.insert(table_index, notify_line)
        else:
            lines[notify_index] = notify_line
        config_path.write_text("\n".join(lines) + "\n")
    else:
        config_path.write_text(notify_line + "\n")
        config_path.chmod(0o600)
    return 0


def clean_summary(value: object) -> str:
    if not isinstance(value, str):
        return "Turn complete"

    # Terminal notifications must never contain control sequences supplied by a
    # model response. Collapse formatting whitespace after removing controls.
    text = re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", value)
    text = re.sub(r"\s+", " ", text).strip()
    if not text:
        return "Turn complete"
    if len(text) > MAX_SUMMARY_CHARS:
        text = text[: MAX_SUMMARY_CHARS - 1].rstrip() + "…"
    return text


def tmux_clients() -> list[tuple[str, str]]:
    if not os.environ.get("TMUX"):
        return []
    try:
        output = subprocess.check_output(
            ["tmux", "list-clients", "-F", "#{client_tty}\t#{client_termname}"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []

    clients = []
    for line in output.splitlines():
        tty, _, term = line.partition("\t")
        if tty:
            clients.append((tty, term))
    return clients


def notify_client(tty: str, term: str, summary: str) -> None:
    try:
        subprocess.run(
            [
                "tmux",
                "display-message",
                "-c",
                tty,
                "-d",
                str(TMUX_MESSAGE_MS),
                f"Codex: {summary}",
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

        # Write to the tmux client's TTY, not the pane TTY. This sends the
        # notification through SSH directly to the local terminal and avoids
        # requiring tmux's allow-passthrough option.
        with open(tty, "wb", buffering=0) as client_tty:
            if "ghostty" in term.lower():
                client_tty.write(f"\x1b]9;Codex: {summary}\x1b\\".encode())
            client_tty.write(b"\a")
    except OSError:
        pass


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--install":
        return install_config()
    if len(sys.argv) != 2:
        return 0
    try:
        notification = json.loads(sys.argv[1])
    except (json.JSONDecodeError, TypeError):
        return 0
    if notification.get("type") != "agent-turn-complete":
        return 0

    summary = clean_summary(notification.get("last-assistant-message"))
    clients = tmux_clients()
    if clients:
        for tty, term in clients:
            notify_client(tty, term, summary)
    else:
        # A plain BEL is the safest fallback outside tmux. The notify process
        # may not own a controlling TTY, so failure here is intentionally quiet.
        try:
            with open("/dev/tty", "wb", buffering=0) as tty:
                tty.write(b"\a")
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
